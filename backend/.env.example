# backend/.env 로 복사해서 채운다. (.env는 git에 올라가지 않는다)
# Supabase → Project Settings → Database → Connection pooling (Session mode, 서울)
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
# 워커 전용 계정 (0032): jjoin_worker.<프로젝트 ref>
DATABASE_USERNAME=jjoin_worker.your-project-ref
DATABASE_PASSWORD=
# Next와 같은 VAPID 키 (Vercel의 NEXT_PUBLIC_VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# false면 대기열만 보고 실제로 보내지 않는다
PUSH_ENABLED=true
