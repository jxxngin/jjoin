# Supabase 대시보드 > Project Settings > API Keys 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 카카오 콘솔 > [앱] > [플랫폼 키] > JavaScript 키 (지도·장소 검색)
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-javascript-key

# 웹 푸시 알림 (VAPID). npx web-push generate-vapid-keys 로 만든다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://kkillae.vercel.app

# Vercel Cron 인증용 임의 문자열
CRON_SECRET=

# Supabase 대시보드 > Project Settings > API Keys > Secret keys (서버 전용)
SUPABASE_SECRET_KEY=

# 홈 하단 광고 배너 목록(JSON). 비워 두면 배너가 나오지 않는다.
# [{"id":"..","src":"이미지 주소","alt":"..","action":"copy","value":"복사할 값","done":"안내 문구"} | {"id":"..","src":"..","alt":"..","action":"link","href":"링크"}]
ADS_JSON=

# 문의하기: 관리자 카톡(나와의 채팅)으로 1시간 요약 보내기. 카카오 콘솔 → 앱 키 → REST API 키
# Client Secret을 켜 두었으면 KAKAO_CLIENT_SECRET도 넣는다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 문의하기: 오류 신고 자동 수정. GitHub 작업을 깨우는 토큰(jjoin 저장소 Contents 쓰기)과
# 작업이 앱에 문의를 받아 가고 결과를 알릴 때 쓰는 공유 암호 (GitHub Secrets에도 같은 값)
GITHUB_DISPATCH_TOKEN=
AUTOFIX_SECRET=
