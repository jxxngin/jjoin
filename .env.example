# Supabase 대시보드 > Project Settings > API Keys 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 카카오 콘솔 > [앱] > [플랫폼 키] > JavaScript 키 (지도·장소 검색)
NEXT_PUBLIC_KAKAO_JS_KEY=your-kakao-javascript-key

# 웹 푸시 알림 (VAPID). npx web-push generate-vapid-keys 로 만든다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://kkillae.vercel.app

# Vercel Cron 인증용 임의 문자열
CRON_SECRET=

# Supabase 대시보드 > Project Settings > API Keys > Secret keys (서버 전용)
SUPABASE_SECRET_KEY=

# 홈 하단 광고 배너 목록(JSON). 비워 두면 배너가 나오지 않는다.
# [{"id":"..","src":"이미지 주소","alt":"..","action":"copy","value":"복사할 값","done":"안내 문구"} | {"id":"..","src":"..","alt":"..","action":"link","href":"링크"}]
ADS_JSON=
